rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    function orderingEnabled() {
      return !exists(
          /databases/$(database)/documents/store_settings/public
        )
        || get(/databases/$(database)/documents/store_settings/public)
          .data.orderingEnabled != false;
    }

    match /store_settings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'photoUrl',
          'role',
          'createdAt'
        ]);
      allow update: if signedIn()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'photoUrl', 'phone'])
          )
          || (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'phone', 'role'])
            && request.resource.data.role in ['customer', 'admin']
            && (request.auth.uid != userId
              || !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role']))
          )
        );
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && orderingEnabled()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Preparing'
        && request.resource.data.keys().hasAll([
          'userId',
          'restaurantName',
          'status',
          'createdAt',
          'address',
          'phone',
          'paymentMethod',
          'items',
          'subtotal',
          'deliveryFee',
          'tax',
          'total'
        ])
        && request.resource.data.keys().hasOnly([
          'userId',
          'restaurantName',
          'status',
          'createdAt',
          'address',
          'phone',
          'paymentMethod',
          'items',
          'subtotal',
          'deliveryFee',
          'tax',
          'total'
        ])
        && request.resource.data.restaurantName is string
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.phone is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.tax is number
        && request.resource.data.tax >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin();
    }
  }
}
